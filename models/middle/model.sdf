<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="my_map">
    <static>true</static>
    <link name="link">
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://middle/meshes/middle.dae</uri> 
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://middle/meshes/middle.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
    </link>
  </model>
</sdf>